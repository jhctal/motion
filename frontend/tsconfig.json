{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "strict": true,
    "noUnusedLocals": false,
    "paths": {
      "#api/*": ["./src/api/*"],
      "#assets/*": ["./src/assets/*"],
      "#hooks/*": ["./src/hooks/*"],
      "#types/*": ["./src/types/*"],
      "#utils/*": ["./src/utils/*"],
      "#ui/*": ["./src/ui/*"]
    }
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ]
}
